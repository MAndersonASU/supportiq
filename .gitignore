# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Environment / secrets
.env
*.env.local

# Data (tracked via DVC, not git)
data/raw/*
data/landing/*
data/validated/*
data/processed/*
!data/raw/.gitkeep
!data/landing/.gitkeep
!data/validated/.gitkeep
!data/validated/validation_report.json
!data/processed/.gitkeep
!data/processed/cleaning_report.json
!data/processed/feature_report.json
!data/processed/labeling_report.json
!data/processed/model_evaluation_report.json
!data/processed/tuning_report.json
!data/processed/registry_report.json
!data/processed/*.dvc

# pytest cache
.pytest_cache/

# MLflow / experiment artifacts
mlruns/
mlartifacts/
mlflow.db
mlflow.db-*

# Vector store / model artifacts
*.faiss
*.chroma/
models/*.pkl
models/*.joblib
!models/.gitkeep

# OS / editor
.DS_Store
.vscode/
.idea/

# Logs
*.log
